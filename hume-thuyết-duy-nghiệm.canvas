		{"id":"3c8a95b21eab4d76","type":"file","file":"01-Quicknote/Trí tưởng tượng.md","x":1880,"y":726,"width":1125,"height":365,"color":"#e27495"},
		{"id":"c3ed5a0af7964b40","type":"text","text":"Ý niệm tổng quát","x":890,"y":823,"width":325,"height":60},
		{"id":"f143a74bee0f7c39","type":"text","text":"Giúp ta khẳng định sự hiện hữu của một đối tượng.\nKhăng định sự thống nhất trong vận hành của tự nhiên.","x":-680,"y":641,"width":597,"height":179},
		{"id":"0eafa8c86fb6d977","type":"text","text":"Tăng cường, chuyển giao độ sống động","x":-984,"y":203,"width":250,"height":127,"color":"4"},
		{"id":"f5fa79759d5cae47","type":"file","file":"09-Attachment/Newton.png","x":2695,"y":-2251,"width":273,"height":400},
		{"id":"c110729db9be4bc7","type":"file","file":"09-Attachment/Lock, chân dung.png","x":1834,"y":-2234,"width":281,"height":366},
		{"id":"d66a194a49b131fb","type":"text","text":"Phê phán ý niệm trừu tượng, phê phán quan niệm vật chất","x":1518,"y":-2640,"width":273,"height":200},
		{"id":"19ce7682b94c77fc","type":"file","file":"09-Attachment/George Berkeley.png","x":1518,"y":-2234,"width":295,"height":400},
		{"id":"9626770cd0475e5f","type":"file","file":"01-Quicknote/nhân quả (Hume).md","x":-1511,"y":641,"width":760,"height":400},
		{"id":"375d53d82721dcdc","type":"file","file":"09-Attachment/Pasted image 20261022084058.png","x":-680,"y":866,"width":499,"height":225},
		{"id":"f53ad3ab41f07090","type":"file","file":"01-Quicknote/Lý thuyết về quan hệ.md","x":-517,"y":135,"width":594,"height":262,"color":"6"},
		{"id":"3e00f79be76adf02","type":"text","text":"Kinh nghiệm: nhắc lại quá khứ.\nThói quen: chờ đợi một kết quả tương tự cho tương lai","x":-1511,"y":1060,"width":760,"height":152},
		{"id":"d0bcf51cc5322b91","type":"text","text":"Xu hướng tổng quát hoá của con người","x":376,"y":397,"width":250,"height":169,"color":"3"},
		{"id":"9c09ce4c97643aaa","type":"file","file":"01-Quicknote/Niềm tin.md","x":-517,"y":-526,"width":480,"height":606,"color":"1"},
		{"id":"4cf59bbc0da6e03f","type":"text","text":"Nguyên lý điều chỉnh","x":256,"y":688,"width":400,"height":50,"color":"1"},
		{"id":"e8012c1904c68d29","type":"file","file":"01-Quicknote/Quan hệ của lý thuyết tri giác của Hume với toán tập hợp..md","x":-1951,"y":1505,"width":1200,"height":1240},
		{"id":"7e2a5f5ba5de6c90","type":"file","file":"01-Quicknote/lý tính, Hume.md","x":-1351,"y":2847,"width":600,"height":291},
		{"id":"00c2b3e3fb71f484","type":"text","text":"Tinh thần vượt quá dữ kiện, trở thành chủ động: nó đi từ cái chưa biết đến cái đã biết, nhưng vẫn không hết bị động (chiêm ngắm)","x":-580,"y":3660,"width":250,"height":474,"color":"3"},
		{"id":"4c77d6e1d3d8d397","type":"text","text":"Niềm chỉ là một loại cảm giác mạnh","x":100,"y":-211,"width":250,"height":138},
		{"id":"780aa788cceae9a9","type":"text","text":"Nguyên lý mở rộng","x":301,"y":-359,"width":400,"height":88,"color":"3"},
		{"id":"ce20680fdd325d76","type":"file","file":"01-Quicknote/Hume, Nhận thức.md","x":256,"y":-804,"width":489,"height":351},
		{"id":"a99127f9f29e89c4","type":"file","file":"05- Projects/Lớp Hume - Tài liệu.md","x":225,"y":-2440,"width":695,"height":1080,"color":"1"},
		{"id":"0888bb417c3c6dca","type":"file","file":"01-Quicknote/Hume, David.md","x":-1960,"y":-2440,"width":1483,"height":1200,"color":"#10c1e5"},
		{"id":"18a4baed2cb6eef5","type":"text","text":"Làm sao bảo đảm tính đúng đắn của khoa học? Tức là tương thích của nhận thức với Tự Nhiên. Hume phải viện đến một Thượng Đế hoà điệu tiền lập ?","x":-680,"y":-1031,"width":828,"height":151,"color":"5"},
		{"id":"3e0de2bec7453e4c","type":"file","file":"01-Quicknote/Hume, Tôn Giáo.md","x":-1259,"y":-387,"width":400,"height":400},
		{"id":"1fe54654e7d06bdd","type":"file","file":"05- Projects/MOC, Thuyết duy nghiệm và tính chủ thể.md","x":-400,"y":-2440,"width":548,"height":1080},
		{"id":"f03f0bd2781e005c","type":"text","text":"Tính thường hằng và đồng đều\n\n**Khuynh hướng**","x":941,"y":2167,"width":718,"height":212,"color":"3"},
		{"id":"5928a7517643ee35","type":"file","file":"01-Quicknote/bản tính con người.md","x":1881,"y":2740,"width":931,"height":725,"color":"4"},
		{"id":"ca5824f8b2ca04cc","type":"text","text":"Đối tượng duy nhất của khoa học tâm trí","x":1789,"y":2109,"width":370,"height":115},
		{"id":"f1718cba82ab42bb","type":"file","file":"01-Quicknote/Quy tắc chung.md","x":540,"y":1794,"width":669,"height":280},
		{"id":"6562c513de863c97","type":"text","text":"CHỦ THÊ\n\nVấn đề trọng tâm của [[Thuyết duy nghiệm]].\n\nChủ thể là tinh thần được cố định, được tổ chức thành hệ thống.\n\nChủ thể tin vào sự hiện hữu của đối tượng bên ngoài.","x":791,"y":2480,"width":653,"height":1045,"color":"2"},
		{"id":"477be4810ff2b025","type":"text","text":"niềm tin vào sự hiện hưu liên tục của các đối tượng bên ngoài. **nguyên lý Thế Giới**.\nniềm tin này được phóng chiếu thông qua sự quan sát bên trong ra bên ngoài.","x":-351,"y":4351,"width":581,"height":223},
		{"id":"5ebf21688e30ca83","type":"file","file":"01-Quicknote/cơ chế sơ đồ.md","x":-187,"y":3732,"width":540,"height":540},
		{"id":"4d84e8683ae5b737","type":"text","text":"Cơ thể/cá thể: gói quan hệ","x":154,"y":2589,"width":226,"height":141,"color":"5"},
		{"id":"d38ba8fd59ffd173","type":"file","file":"01-Quicknote/Thói quen.md","x":-120,"y":1906,"width":400,"height":609,"color":"4"},
		{"id":"ca40972727089cdb","type":"text","text":"Xác suât","x":-461,"y":1663,"width":250,"height":60},
		{"id":"148f929a2b175e83","type":"text","text":"KHUYNH HƯỚNG dự đoán","x":977,"y":1562,"width":465,"height":101,"color":"4"},
		{"id":"015b7ab48860ad14","type":"file","file":"01-Quicknote/Huyễn tưởng.md","x":2605,"y":1134,"width":400,"height":409},
		{"id":"d8ced2948866d4b0","type":"text","text":"Tốc độ nhanh/ chậm","x":1880,"y":1399,"width":280,"height":95,"color":"#dd5ac1"},
		{"id":"7f22881fef5db43c","type":"text","text":"Ý niệm Bản thể / thể cách","x":890,"y":956,"width":319,"height":63},
		{"id":"31ede5de56163130","type":"text","text":"Kề nhau","x":1420,"y":911,"width":250,"height":60,"color":"5"},
		{"id":"631638f4e05a57a0","type":"text","text":"Ý niệm Quan hệ","x":890,"y":1091,"width":319,"height":67},
		{"id":"c69511e0e30d5feb","type":"text","text":"sự chuyển dịch dễ dàng hay khó khăn từ ý niệm này sang ý niệm kia","x":977,"y":1314,"width":465,"height":132,"color":"2"},
		{"id":"99b532bd7573821d","type":"text","text":"Nhân quả","x":1420,"y":998,"width":250,"height":60,"color":"5"},
		{"id":"e30cec18eac200e8","type":"text","text":"Giống nhau","x":1420,"y":823,"width":250,"height":60,"color":"5"},
		{"id":"2721039126ba66b3","type":"file","file":"09-Attachment/Pasted image 20261021144303.png","x":1570,"y":1116,"width":201,"height":198},
		{"id":"5d5e850e5d39b086","type":"text","text":"Ấn tượng ","x":4146,"y":954,"width":164,"height":60,"color":"5"},
		{"id":"75e67b2b913eb3b0","type":"text","text":"Ý niệm","x":4577,"y":954,"width":125,"height":50,"color":"5"},
		{"id":"f17e6b00db728c3b","type":"text","text":"Sống động","x":3810,"y":1044,"width":250,"height":60},
		{"id":"624c2b4aae70a459","type":"text","text":"Ấn tượng cảm giác","x":3851,"y":1158,"width":250,"height":60,"color":"5"},
		{"id":"acbea8ef9b66461b","type":"text","text":"ấn tượng đơn","x":4101,"y":1049,"width":254,"height":50},
		{"id":"3003c181f27b80c2","type":"text","text":"Mọi ý niệm đều truy được về một ấn tượng nào đó. Nếu có một ý niệm không truy được về ấn tượng thì đó là sản phẩm của tinh thần chứ không phải đến từ kinh nghiệm. Ví dụ: nhân quả.","x":4702,"y":1189,"width":778,"height":151,"color":"1"},
		{"id":"48d506788b8161e2","type":"text","text":"Ấn tượng phản tư","x":4264,"y":1188,"width":250,"height":60,"color":"5"},
		{"id":"786006d7df7da46f","type":"text","text":"ý niệm đơn","x":4640,"y":1044,"width":250,"height":60},
		{"id":"39e06c7793343065","type":"text","text":"Ít sống động","x":4960,"y":1044,"width":250,"height":60},
		{"id":"18eacad72f174d13","type":"text","text":"kí ức : sống động hơn","x":3851,"y":1360,"width":413,"height":53},
		{"id":"aa8d8677f6d52045","type":"text","text":"trí tưởng tượng: ít sống động hơn nhưng tự do hơn","x":3851,"y":1425,"width":413,"height":103},
		{"id":"adfe22f87cd1ed79","type":"text","text":"Có một ngưỡng tri giác tối thiểu. từ ngưỡng đó thì không thể phân nhỏ tri giác hơn nữa.=> thuyết nguyên tử","x":4696,"y":1377,"width":778,"height":151,"color":"1"},
		{"id":"aa58a94e796e3b5a","type":"text","text":"Dữ kiện, cái được mang lại.","x":3810,"y":830,"width":319,"height":74,"color":"5"},
		{"id":"cf02990227f2777a","type":"text","text":"Tri giác: cảm xúc, cảm giác, ý niệm, ý muốn v.v..","x":4146,"y":800,"width":556,"height":104,"color":"5"},
		{"id":"2773dc0596863fae","type":"file","file":"09-Attachment/Pasted image 20261022082846.png","x":4804,"y":719,"width":575,"height":185},
		{"id":"a4e1d0cce20ad11e","type":"link","url":"https://thingspool.net/morsels/page-3.html","x":5743,"y":554,"width":520,"height":563},
		{"id":"f6e245817694f2dc","type":"file","file":"01-Quicknote/nguyên lý liên tưởng.md","x":8466,"y":675,"width":400,"height":400},
		{
			"id":"1c488711856e4b9d",
			"type":"text",
			"text":"cảm xúc cho liên tưởng một chiều, một hướng đi. Ngược lại, nguyên lý cảm xúc giả định sự liên tưởng",
			"styleAttributes":{},
			"x":8980,
			"y":675,
			"width":260,
			"height":400
		},
		{
			"id":"015429f27632cdb6",
			"type":"text",
			"text":"Sự can thiệp của [[giác tính]]\n\nChính là để biến một cảm xúc trở thành xã hội.",
			"styleAttributes":{},
			"x":10200,
			"y":-625,
			"width":350,
			"height":330
		},
		{"id":"1c93c72eae26d0eb","type":"text","text":"[[cơ chế sơ đồ]] \nQuy tắc chung\nLợi ích tập thể","x":10300,"y":-901,"width":250,"height":226,"color":"2"},
		{
			"id":"45fa6445870c6c0d",
			"type":"text",
			"text":"[[lý tính, Hume]] không sinh ra hành động.\n\nXem [[Spinoza]], lý tính muốn tác động lên hành động thì phải sinh ra một cảm xúc mạnh (chính là nhân quả tất yếu)",
			"styleAttributes":{},
			"x":7920,
			"y":-225,
			"width":720,
			"height":220
		},
		{"id":"0a1c688cbea030c3","type":"text","text":"Luân lý bắt nguồn từ quy ước nhân tạo, sinh ra trong xã hội. Nguồn gốc của nó bắt nguồn từ việc giải quyết sự [[sở hữu]], vì sự sở hữu sinh ra mâu thuẫn.\n\nĐối lập với: [[quan niệm công lý của Plato]], có nguồn gốc siêu việt. \nĐối lập với [[Công lý]] xét như trao đổi, có nguồn gốc thương mại.","x":8560,"y":-1320,"width":631,"height":317},
		{"id":"8f88338fe7037898","type":"file","file":"01-Quicknote/sở hữu.md","x":8760,"y":-746,"width":400,"height":400},
		{
			"id":"376bff921b777567",
			"type":"text",
			"text":"Mục tiêu của luân lý, công lý là thiết lập một toàn thể, là tích hợp thành một toàn thể những lòng thông cảm.\n\n* Vấn đề của cái toàn thể,[[Bergson]], Kant.\n* Luân lý có được nhờ áp dụng các [[quy tắc chung]] của sự sở hữu. Nhờ hai nguyên lý *mở rộng* và *điều chỉnh*, tạo ra cả một thế giới luân lý, công lý. Tức một thế giới mà những cảm xúc và lợi ích cá nhân nhường chỗ cho các quy tắc khác.\n\n",
			"styleAttributes":{
				"shape":null
			},
			"x":9400,
			"y":-901,
			"width":637,
			"height":456
		},
		{
			"id":"8bb43f8b8f7d03d1",
			"type":"text",
			"text":"Thiên hướng, cảm xúc [[Phản tư]] , trở thành xã hội. Cảm xúc vượt quá lợi ích riêng.",
			"styleAttributes":{},
			"x":9400,
			"y":-365,
			"width":637,
			"height":140
		},
		{
			"id":"8492919d9cc69e26",
			"type":"text",
			"text":"Dựa trên một thiên hướng tự nhiên để *đổi hướng* chữ không *thay đổi* nó.",
			"styleAttributes":{},
			"x":8830,
			"y":-225,
			"width":260,
			"height":220
		},
		{
			"id":"68080f8caca94f59",
			"type":"text",
			"text":"# **nguyên lý cảm xúc**\nlợi ích, lòng thông cảm.\n\n[[cảm xúc]] rung động tinh thần. Theo nghĩa: hiệu ứng của cảm xúc trong tinh thần ==🔴âm vang, échos, vọng âm,== do đó cố định tinh thần.\n\n",
			"styleAttributes":{},
			"x":9360,
			"y":675,
			"width":480,
			"height":400
		},
		{
			"id":"3295ec62e4af1f01",
			"type":"text",
			"text":"Tinh thần giống như nhạc khí gõ hoặc bộ dây, không phải bộ khí.\n\n[[tinh thần, Hume]]",
			"styleAttributes":{},
			"x":9900,
			"y":675,
			"width":340,
			"height":400
		},
		{"id":"f6ff7ecaabf571ee","type":"file","file":"01-Quicknote/Thuyết hoài nghi.md","x":3331,"y":-1432,"width":400,"height":400},
		{"id":"e2969297a8a9550b","type":"text","text":"Thiết chê\nBiện pháp","x":3324,"y":-831,"width":250,"height":174},
		{"id":"7e15a24cb7904b20","type":"text","text":"**Tinh thần**\n\nĐồng nhất với tập hợp ý niệm, với trí tưởng tượng.\nBản tính của tinh thần là vượt quá, là thói quen, khuynh hướng. Tinh thần là phát minh, sáng tạo, tổng quát hoá. Nó tin.","x":3182,"y":-40,"width":392,"height":489,"color":"4"},
		{"id":"2888ecb732528cfb","type":"text","text":"Luân lý, công lý\n\nTheo nghĩa xã hội, chỉ ở trong xã hội mới xuất hiện [[Công lý]], lập trường gần với [[Spinoza]], thuyết khế ước.\n\n* không thể là kết quả của lý tính (vì lý tính không gây ảnh hưởng lên hành động).\n* không thể sinh ra từ các cảm xúc nền tảng vì công lý bao gồm vô số các xúc động khác, và thường có tính cưỡng chế.\n* Cảm xúc gốc: tính thiên vị và lòng cảm thông.\n* công lý là mở rộng lòng cảm thông, là hạn chế sự thiên vị.\n* chống lại quan niệm xem con người là [[vị kỉ]].","x":7836,"y":-1320,"width":670,"height":495},
		{
			"id":"804ae606b3cca1ea",
			"type":"file",
			"file":"01-Quicknote/Thông Cảm.md",
			"styleAttributes":{"border":"dashed"},
			"x":7836,
			"y":-746,
			"width":670,
			"height":407
		},
		{
			"id":"905bb8bafa838975",
			"type":"text",
			"text":"Tình cảm luân lý: tán thành hay phản đối dựa trên [[Quy tắc chung]]",
			"styleAttributes":{},
			"x":8980,
			"y":275,
			"width":540,
			"height":200
		},
		{
			"id":"1ab6156deb2ce6f8",
			"type":"text",
			"text":"hiện hữu",
			"styleAttributes":{},
			"x":4938,
			"y":4725,
			"width":260,
			"height":60,
			"color":"2"
		},
		{
			"id":"98047e5765ab1086",
			"type":"text",
			"text":"  một ấn tượng phản tư.",
			"styleAttributes":{},
			"x":4318,
			"y":4910,
			"width":460,
			"height":80
		},
		{"id":"1de5821234954b06","type":"link","url":"https://www.cosmos.so/e/858490600","x":3763,"y":5860,"width":470,"height":400},
		{
			"id":"c2c6f4c205bb5ec1",
			"type":"text",
			"text":"mỗi lần ==🟠âm vang== là một ý niệm tổng quát được tạo ra ?",
			"styleAttributes":{},
			"x":3773,
			"y":6320,
			"width":450,
			"height":140
		},
		{"id":"72918fef1f283080","type":"file","file":"Excalidraw/bergson hình nón kí ức.md","x":4318,"y":5285,"width":420,"height":575},
		{"id":"79a3a3771f537d4e","type":"file","file":"09-Attachment/IMG_8550.jpeg","x":4318,"y":5959,"width":420,"height":560},
		{
			"id":"cc0b6e40fbcbdb6d",
			"type":"text",
			"text":"Nhận thức có ==🔴tính mở rộng== VÌ nó cốt ở một sự ==🟢quy định giữa các bộ phận==.\nVì nhận thức giả định nguyên lý thói quen (liên hệ với kinh nghiệm), cho nên một sự tràn vượt của trí tưởng tượng (so với kinh nghiệm) là điều không mong muốn.",
			"styleAttributes":{},
			"x":4358,
			"y":7040,
			"width":500,
			"height":340
		},
		{"id":"b09a55ce532e3ce2","type":"file","file":"09-Attachment/Wielen, tr.65.png","x":3096,"y":6920,"width":1035,"height":760},
		{"id":"3c00c575816e6e20","type":"file","file":"01-Quicknote/xúc động.md","x":5638,"y":5240,"width":1080,"height":200},
		{"id":"da3a9d580b310540","type":"file","file":"01-Quicknote/thuyết khoái lạc.md","x":6098,"y":5559,"width":620,"height":400},
		{
			"id":"e39764dbd4be5b91",
			"type":"text",
			"text":"**nhận thức đi từ những phần đã biết đến những phần chưa biết; \nluân lý tích hợp những đam mê thiên vị vào một toàn thể được sáng tạo.**",
			"styleAttributes":{},
			"x":5038,
			"y":6870,
			"width":1120,
			"height":170
		},
		{
			"id":"1c2031474b4722f4",
			"type":"text",
			"text":"âm vang trong tinh thần",
			"styleAttributes":{},
			"x":4318,
			"y":5140,
			"width":460,
			"height":100
		},
		{"id":"32c404ec453d2cb7","type":"link","url":"https://cdn.cosmos.so/706d387a-1549-4cc9-a480-4e133a187744?format=webp","x":3994,"y":2179,"width":400,"height":400},
		{"id":"f87b7969c7c33322","type":"file","file":"09-Attachment/Pasted image 20261021233601.png","x":4424,"y":2179,"width":257,"height":400},
		{"id":"4fb4d2da93f8bb41","type":"file","file":"90-Excalidraw/Sự tổ chức ý niệm trong tinh thần.md","x":3101,"y":2179,"width":860,"height":400},
		{"id":"0d5b82359fc2ea82","type":"file","file":"09-Attachment/Pasted image 20261025104627.png","x":4778,"y":5960,"width":630,"height":279},
		{
			"id":"a2bd98a3f4aa80a3",
			"type":"text",
			"text":"ý niệm tổng quát",
			"styleAttributes":{},
			"x":4938,
			"y":4865,
			"width":260,
			"height":60,
			"color":"2"
		},
		{
			"id":"23d71a919892e71c",
